# =============================================================================
# HeatGuard AI — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# =============================================================================

# FortyGuard API
FORTYGUARD_API_KEY=your_api_key_here
FORTYGUARD_BASE_URL=https://api.fortyguard.com/v1

# Database
DATABASE_URL=postgresql+asyncpg://heatguard:heatguard_password@db:5432/heatguard_db
POSTGRES_USER=heatguard
POSTGRES_PASSWORD=heatguard_password
POSTGRES_DB=heatguard_db

# Async Job Polling Configuration
POLL_INTERVAL_SECONDS=5
MAX_POLL_ATTEMPTS=60

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
